{
  "name": "@knowledgeislands/mcp-m365",
  "description": "MCP for Microsoft 365 (Outlook, OneDrive) access via the Microsoft Graph API",
  "version": "0.9.0",
  "author": "kris@kris.me.uk",
  "bin": {
    "mcp-m365": "dist/mcp-server/index.js",
    "mcp-m365-auth": "dist/auth-server/index.js"
  },
  "bugs": {
    "url": "https://github.com/knowledgeislands/mcp-m365/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "mcporter": "^0.13.0",
    "rumdl": "^0.2.52",
    "syncpack": "^15.3.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/mcp-server/index.d.ts",
      "import": "./dist/mcp-server/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./auth": {
      "types": "./dist/main/auth/index.d.ts",
      "import": "./dist/main/auth/index.js"
    },
    "./graph-client": {
      "types": "./dist/main/graph-client/index.d.ts",
      "import": "./dist/main/graph-client/index.js"
    },
    "./email": {
      "types": "./dist/main/email/index.d.ts",
      "import": "./dist/main/email/index.js"
    },
    "./folder": {
      "types": "./dist/main/folder/index.d.ts",
      "import": "./dist/main/folder/index.js"
    },
    "./calendar": {
      "types": "./dist/main/calendar/index.d.ts",
      "import": "./dist/main/calendar/index.js"
    },
    "./onedrive": {
      "types": "./dist/main/onedrive/index.d.ts",
      "import": "./dist/main/onedrive/index.js"
    },
    "./rules": {
      "types": "./dist/main/rules/index.d.ts",
      "import": "./dist/main/rules/index.js"
    },
    "./triage": {
      "types": "./dist/main/triage/index.d.ts",
      "import": "./dist/main/triage/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/knowledgeislands/mcp-m365#readme",
  "keywords": [
    "anthropic",
    "claude",
    "graph-api",
    "mcp",
    "microsoft-365",
    "model-context-protocol",
    "onedrive",
    "outlook"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "bunx @biomejs/biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "bunx rumdl check --fix"
    ]
  },
  "main": "dist/mcp-server/index.js",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/mcp-m365.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf {dist,node_modules}",
    "ki:deps:update": "bun update --latest",
    "ki:generate:client": "mcporter emit-ts hnr-mcp-m365 --mode client --out src/generated/client.ts --types-out src/generated/types.d.ts && printf '// @ts-nocheck\\n' | cat - src/generated/client.ts > /tmp/gen-tmp.ts && mv /tmp/gen-tmp.ts src/generated/client.ts",
    "ki:lint:rules": "bun scripts/lint-rules.ts",
    "ki:server:auth:dev": "NODE_ENV=development bun --watch src/auth-server/index.ts",
    "ki:server:auth:start": "bun run build && node dist/auth-server/index.js",
    "ki:server:mcp:dev": "NODE_ENV=development bun --watch src/mcp-server/index.ts",
    "ki:server:mcp:inspect": "NODE_ENV=development bunx @modelcontextprotocol/inspector bun src/mcp-server/index.ts",
    "ki:server:mcp:start": "bun run build && node dist/mcp-server/index.js",
    "ki:test:record": "mcporter record m365-integration --server hnr-mcp-m365 -- bun scripts/integration.ts && cp ~/.mcporter/recordings/m365-integration.ndjson fixtures/recordings/m365-integration.ndjson",
    "ki:test:replay": "cp fixtures/recordings/m365-integration.ndjson ~/.mcporter/recordings/m365-integration.ndjson && mcporter replay m365-integration -- bun scripts/integration.ts",
    "ki:test:smoke": "bun run build && bun scripts/smoke.ts",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module"
}
