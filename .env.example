# Microsoft Azure App Registration Credentials
# Get these from Azure Portal > App Registrations > Your App

# Application (client) ID from Azure Portal
MCP_M365_CLIENT_ID=your-client-id-here

# Client secret VALUE (not the secret ID) from Azure Portal > Certificates & secrets
MCP_M365_CLIENT_SECRET=your-client-secret-here

# Directory (tenant) ID from Azure Portal > Microsoft Entra ID > Overview
# For single-tenant apps, set this to your tenant GUID so /common is not used.
MCP_M365_TENANT_ID=your-tenant-id-here

# --- Optional overrides (defaults shown) ---------------------------------
# These rarely need to be set. See README "Supported variables" for details.

# Maximum access level to register. One of: read, write, destructive.
# Levels nest: `read` registers only read-only tools (the default — least
# privilege); `write` adds non-destructive mutations (send/draft email,
# create events, OneDrive uploads); `destructive` adds delete tools. Each
# tool's level is derived from its MCP annotations (readOnlyHint /
# destructiveHint), not its name; see src/utils/access-level.ts.
# MCP_M365_ACCESS_LEVEL=destructive

# OAuth authority host. Override for sovereign clouds (US Gov, China, etc).
# MCP_M365_AUTHORITY_HOST=https://login.microsoftonline.com

# OAuth redirect URI. Must match what is registered in Azure.
# MCP_M365_REDIRECT_URI=http://localhost:3333/auth/callback

# Port the auth server listens on (must match the redirect URI port).
# MCP_M365_AUTH_PORT=3333

# Space-separated OAuth scopes requested for the access token.
# MCP_M365_SCOPES=offline_access User.Read Mail.Read

# Full token endpoint URL. Override only if your authority uses a non-standard path.
# MCP_M365_TOKEN_ENDPOINT=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
