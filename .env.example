# ─────────────────────────────────────────────────────────────────────────
# mcp-m365 — environment template.
# Copy to `.env.development` for local `bun run server:mcp:dev`, or set these
# in your MCP client's `env` block. `.env.local` is also loaded (in every mode),
# so you can keep machine-local overrides there. See README.md for full setup.
# `.env.*` files are gitignored; only `.env*.example` templates are committed.
# ─────────────────────────────────────────────────────────────────────────

# Microsoft Azure App Registration credentials.
# Get these from Azure Portal > App Registrations > Your App.

# Application (client) ID from Azure Portal.
MCP_M365_CLIENT_ID=your-client-id-here

# Client secret VALUE (not the secret ID) from Azure Portal > Certificates & secrets.
MCP_M365_CLIENT_SECRET=your-client-secret-here

# Directory (tenant) ID from Azure Portal > Microsoft Entra ID > Overview.
# For single-tenant apps, set this to your tenant GUID so /common is not used.
MCP_M365_TENANT_ID=your-tenant-id-here

# --- Optional overrides (defaults shown) ---------------------------------

# OAuth authority host. Override for sovereign clouds (US Gov, China, etc).
# MCP_M365_AUTHORITY_HOST=https://login.microsoftonline.com

# OAuth redirect URI. Must match what is registered in Azure.
# MCP_M365_REDIRECT_URI=http://localhost:3333/auth/callback

# Port the auth server listens on (must match the redirect URI port).
# MCP_M365_AUTH_PORT=3333

# Space-separated OAuth scopes requested for the access token.
# MCP_M365_SCOPES=offline_access User.Read Mail.Read Mail.ReadWrite Mail.Send Calendars.Read Calendars.ReadWrite Files.Read Files.ReadWrite

# Full token endpoint URL. Override only if your authority uses a non-standard path.
# MCP_M365_TOKEN_ENDPOINT=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token

# ─────────────────────────────────────────────────────────────────────────
# Access level & audit log — conventions shared across all HNR MCP servers.
# ─────────────────────────────────────────────────────────────────────────

# Maximum access level to register at server boot. One of: read, write,
# destructive. Levels nest: `read` registers only read-only tools; `write`
# adds non-destructive mutations; `destructive` adds delete/overwrite tools.
# A tool's level is derived from its MCP annotations (readOnlyHint /
# destructiveHint), not its name — see src/utils/access-level.ts.
# Default: read.
# MCP_M365_ACCESS_LEVEL=destructive

# Audit log of tool invocations, written as JSONL. One of: off, writes, all.
#   off    — no audit logging
#   writes — record write/destructive calls only (default)
#   all    — record every call, including reads
# MCP_M365_AUDIT_LOG=writes

# Path to the audit log file.
# MCP_M365_AUDIT_LOG_PATH=~/.local/state/mcp-m365/audit.jsonl

# Rotate the audit log when it exceeds this many bytes (0 disables rotation).
# Default: 10485760 (10 MiB).
# MCP_M365_AUDIT_LOG_MAX_BYTES=10485760

# Number of rotated audit logs to keep. Default: 5.
# MCP_M365_AUDIT_LOG_KEEP=5
